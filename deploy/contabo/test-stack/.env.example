# Swimmich test stack env on the Contabo VPS: /opt/immich-test/.env (never committed, deleted on teardown).
# Pin the exact CI build under test (:test-<sha>, shown in the "Swimmich Build & Deploy" run).
SWIMMICH_IMAGE=ghcr.io/greattoubib/swimmich-server:test-<sha>

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Own random password, not prod's: the restore uses pg_dump, which carries no roles.
DB_PASSWORD=<openssl rand -hex 16>
