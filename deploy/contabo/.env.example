# Swimmich prod env on the Contabo VPS: /opt/immich/.env (never committed).
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# Custom Immich image built by CI from the `swimmich` branch.
SWIMMICH_IMAGE=ghcr.io/greattoubib/swimmich-server:prod
# Stock machine-learning image, pinned to the fork's base version.
ML_VERSION=v3.2.4
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=<generated, see the VPS>
